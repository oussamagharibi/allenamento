# Password unica per accedere al sito (pagina 1)
SITE_PASSWORD=cambiami

# Segreto per firmare i cookie di sessione (stringa lunga e casuale)
SESSION_SECRET=metti-qui-una-stringa-casuale-lunga

# Master password del pannello /admin (opzionale: senza, il pannello risponde 404)
ADMIN_PASSWORD=

# Connessione PostgreSQL (su Railway la variabile viene fornita dal servizio Postgres)
DATABASE_URL=postgresql://utente:password@host:5432/database

# Chiave API Anthropic (opzionale: senza di essa l'app funziona ma il Coach AI e disattivato)
ANTHROPIC_API_KEY=

# Modello Claude da usare (opzionale)
CLAUDE_MODEL=claude-sonnet-5

# --- Spotify (opzionale) ---
# Servono tutte e quattro: senza, la sezione Musica resta attiva ma con i soli
# link di ricerca, senza collegamento all account.
# Le credenziali si creano su https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Deve combaciare con il Redirect URI registrato nella dashboard di Spotify,
# per esempio https://allenamento.up.railway.app/api/spotify/callback
SPOTIFY_REDIRECT_URI=
# Chiave con cui si cifrano i token nel database: 32 byte in esadecimale.
# Si genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_KEY=
