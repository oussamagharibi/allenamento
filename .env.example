# Password unica per accedere al sito (pagina 1)
SITE_PASSWORD=cambiami

# Segreto per firmare i cookie di sessione (stringa lunga e casuale)
SESSION_SECRET=metti-qui-una-stringa-casuale-lunga

# Master password del pannello /admin (opzionale: senza, il pannello risponde 404)
ADMIN_PASSWORD=

# Connessione PostgreSQL (su Railway la variabile viene fornita dal servizio Postgres)
DATABASE_URL=postgresql://utente:password@host:5432/database

# Chiave API Anthropic (opzionale: senza di essa l'app funziona ma il Coach AI e disattivato)
ANTHROPIC_API_KEY=

# Modello Claude da usare (opzionale)
CLAUDE_MODEL=claude-sonnet-5
